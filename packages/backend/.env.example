PORT=3005
NODE_ENV=development
CORS_ORIGIN='http://localhost:8080'
FRONTEND_URL='http://localhost:8080'
SIGNUP_FLAG=disabled

SECRET_KEY=somesupermegasecretkey

# bare cluster hostname only (e.g. cluster0.xxxxx.mongodb.net) --
# no leading protocol, no trailing path or query string, those are
# built from DB_USER/DB_PASSWORD/DB_NAME in index.audio-library.js
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=AudioLibrary

R2_BUCKET_NAME=audio-library
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_APP_NAME=Audio Library